    "error.healthKit.authorizationDenied": {
      "comment": "HealthKit 권한 거부",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit access was denied. Please enable it in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터 접근이 거부되었습니다. 설정에서 권한을 허용해주세요."
          }
        }
      }
    },
    "error.healthKit.backgroundDeliveryFailed": {
      "comment": "HealthKit 백그라운드 전송 실패",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to enable background health data updates."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 건강 데이터 업데이트 설정에 실패했습니다."
          }
        }
      }
    },
    "error.healthKit.dataFetchFailed": {
      "comment": "HealthKit 데이터 조회 실패",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to fetch health data. Please try again."
          }
