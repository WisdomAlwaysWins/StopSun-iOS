        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건강 데이터를 불러오는데 실패했습니다. 다시 시도해주세요."
          }
        }
      }
    },
    "error.healthKit.notAvailable": {
      "comment": "HealthKit 사용 불가",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthKit is not available on this device."
