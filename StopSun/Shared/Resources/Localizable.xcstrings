        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 건강 데이터를 사용할 수 없습니다."
          }
        }
      }
    },
    "error.location.authorizationDenied": {
      "comment": "위치 권한 거부",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
